<?php
use app\Controllers\AppController;
use app\Controllers\FormController;
use app\Models\Url;

$s = $this->pageObj->settings;

$tabs = [
    'email' => ['label' => 'Email', 'on' => $s->twoFactorEnabled],
    'totp' => ['label' => 'Authenticator', 'on' => $s->totpEnabled],
    'passkey' => ['label' => 'Passkeys', 'on' => $s->passkeyEnabled],
];

// Already validated and defaulted per-card by TwoFactorSettings::loadState().
$primaryCardTab = $s->activeTab;
$secondCardTab = $s->activeManageTab;

// The method offered first at the login challenge, only meaningful once 2FA is on.
$isDefault = static fn(string $method): bool => $s->twoFactorEnabled && $s->primaryMethod === $method;

$methodEnabled = static fn(string $method): bool => match ($method) {
  'email' => $s->twoFactorEnabled,
  'totp' => $s->totpEnabled,
  'passkey' => $s->passkeyEnabled,
  default => false,
};

// Shared across all three method panels, so the footer isn't repeated per tab.
$primaryFooter = function (string $method) use ($isDefault, $methodEnabled): void {
  ?>
  <?php if ($methodEnabled($method)) : ?>
    <div class="row">
      <hr class="col muted">
    </div>

    <?php if ($isDefault($method)) : ?>
      <div class="row">
        <div class="col center-x">
          <p class="two-fa-note">Default method. This is the first thing you're asked for when you sign in.</p>
        </div>
      </div>
    <?php else : ?>
      <div class="row">
        <form class="col" method="POST" action="">
          <input type="hidden" name="action" value="set-primary">
          <input type="hidden" name="primary_method" value="<?= $method ?>">
          <div class="row g-2 center-x">
            <button class="col button button-sm g-col-0.5 center-y f-0" type="submit" name="submit"><i class="fas fa-star"></i>Make default</button>
          </div>
        </form>
      </div>
    <?php endif ?>
  <?php endif ?>
  <?php
};

// Reused by both password-gated forms below: turning 2FA off, and replacing recovery codes.
// $idSuffix keeps each field's id unique since every panel stays mounted, just hidden via CSS.
// A failed confirmation redirects instead of re-rendering, so there's no POST state to flag as errored.
$currentPasswordConfirm = function (string $idSuffix, string $ariaContext): void {
  $this->component('form/form-input', [
      'id' => $idSuffix === '' ? 'current-password' : "current-password-$idSuffix",
      'fieldName' => 'current-password',
      'label' => 'Current password',
      'required' => true,
      'icon' => 'lock',
      'type' => 'password',
      'maxlength' => MAX_PASSWORD_LENGTH,
      'placeholder' => 'Enter current password:',
      'autocomplete' => 'current-password',
      'ariaLabel' => "Current password, required to $ariaContext",
  ]);
};

// A lightweight "are you sure" dialog for removing a single enrolled factor; no password needed.
$areYouSureModal = function (string $id, string $formId, string $question, string $buttonText): void {
  $this->component('modal/confirm-modal', ['id' => $id, 'formId' => $formId, 'question' => $question, 'buttonText' => $buttonText]);
};
