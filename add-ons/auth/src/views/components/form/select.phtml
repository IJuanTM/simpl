<?php
/**
 * A native single <select>, styled like a form-input group.
 *
 * @var string                                          $id       HTML id for the <select>
 * @var string|null                                     $name     HTML "name" attribute, defaults to $id
 * @var string                                          $label
 * @var string                                          $icon     Font Awesome icon suffix for the prepend icon, e.g. "user-group"
 * @var array<int, array{value: string, label: string}> $options  Values/labels already sanitized by the caller
 * @var string                                          $selected Value to pre-select, already sanitized by the caller
 * @var bool                                            $required Adds the red "*" marker after the label
 */

$name ??= $id;
$required ??= false;
?>

<div class="col form-group g-row-0.25">
  <div class="row">
    <label class="col" for="<?= $id ?>"><?= $label ?>:<?php if ($required) : ?> <span class="required">*</span><?php endif ?></label>
  </div>
  <div class="row input-group">
    <div class="col input-prepend center f-0"><i class="fas fa-<?= $icon ?>"></i></div>
    <select class="col" id="<?= $id ?>" name="<?= $name ?>">

      <?php foreach ($options as $option) : ?>

        <option value="<?= $option['value'] ?>"<?= $selected === $option['value'] ? ' selected' : '' ?>><?= $option['label'] ?></option>

      <?php endforeach ?>

    </select>
  </div>
</div>
