<?php
use app\Controllers\AppController;

/**
 * A lightweight "are you sure?" dialog that submits an external hidden form by id.
 * Opened generically via data-open-modal, no per-instance JS wiring needed.
 *
 * @var string $id Dialog id, targeted by a trigger's data-open-modal
 * @var string $formId Id of the hidden <form> elsewhere on the page to submit
 * @var string $question Confirmation question shown in the modal body
 * @var string $buttonText Submit button label, e.g. "Remove passkey"
 */
?>

<dialog class="modal-overlay confirm-modal" id="<?= AppController::sanitize($id) ?>" tabindex="-1" aria-label="<?= AppController::sanitize($buttonText) ?>">
  <div class="col modal f-col g-row-2">
    <div class="row center-y g-col-1">
      <h3 class="col">Are you sure?</h3>
      <button class="col link modal-close lh-1 g-col-0.5 center-y f-0" type="button" aria-label="Close modal"><i class="fas fa-xmark"></i></button>
    </div>

    <div class="row modal-body">
      <div class="col">
        <p><?= AppController::sanitize($question) ?></p>
      </div>
    </div>

    <div class="row g-2 center-x">
      <button class="col link modal-close lh-1 g-col-0.5 center-y f-0" type="button"><i class="fas fa-xmark"></i>Cancel</button>
      <button class="col button button-sm error g-col-0.5 center-y f-0" type="submit" name="submit" form="<?= AppController::sanitize($formId) ?>"><i class="fas fa-trash"></i><?= AppController::sanitize($buttonText) ?></button>
    </div>
  </div>
</dialog>
