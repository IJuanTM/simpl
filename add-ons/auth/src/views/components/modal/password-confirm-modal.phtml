<?php
use app\Controllers\AppController;

/**
 * Asks for the current password before a sensitive change is saved. The field belongs to the form outside the dialog (form attribute), so it posts with it.
 * Live validation opens the dialog itself: the field only becomes required once $requiredWith changes, and an invalid field inside a closed dialog opens it instead of showing an error.
 *
 * @var string $id           Dialog id
 * @var string $formId       Id of the form the password is submitted with
 * @var string $requiredWith Id of the field whose change makes the password required
 * @var string $text         Explanation shown above the field
 * @var string $buttonText   Submit button label
 * @var string $icon         Font Awesome icon suffix for the submit button
 */

$id = AppController::sanitize($id);
$formId = AppController::sanitize($formId);
?>

<dialog class="modal-overlay" id="<?= $id ?>" tabindex="-1" aria-label="Confirm your password">
  <div class="col modal f-col g-row-2">
    <div class="row center-y g-col-1">
      <h3 class="col">Confirm your password</h3>
      <button class="col link close-modal lh-1 g-col-0.5 center f-0" type="button" command="close" commandfor="<?= $id ?>" aria-label="Close modal"><i class="fas fa-xmark"></i></button>
    </div>

    <div class="row modal-body">
      <div class="col f-col g-row-1">
        <div class="row">
          <div class="col">
            <p><?= AppController::sanitize($text) ?></p>
          </div>
        </div>

        <div class="row">
          <?php $this->component('form/form-input', [
              'id' => 'current-password',
              'label' => 'Current password',
              'icon' => 'lock',
              'type' => 'password',
              'maxlength' => MAX_PASSWORD_LENGTH,
              'placeholder' => 'Enter current password:',
              'autocomplete' => 'current-password',
              'extraAttrs' => 'form="' . $formId . '" data-required-with="' . AppController::sanitize($requiredWith) . '"',
          ]) ?>
        </div>
      </div>
    </div>

    <div class="row g-2 center-x">
      <button class="col link lh-1 g-col-0.5 center-y f-0" type="button" command="close" commandfor="<?= $id ?>"><i class="fas fa-xmark"></i>Cancel</button>
      <button class="col button g-col-0.5 center-y f-0" type="submit" name="submit" form="<?= $formId ?>" data-track-ignore><i class="fas fa-<?= AppController::sanitize($icon) ?>"></i><?= AppController::sanitize($buttonText) ?></button>
    </div>
  </div>
</dialog>
