            <input class="col" id="code" type="text" name="code" maxlength="32" autocomplete="one-time-code" autocapitalize="characters" placeholder="Enter a recovery code" value="<?= RequestController::post('code') ?? '' ?>">
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col">
          <p class="form-details"><a class="link underline" href="<?= AppController::sanitize(Url::to('two-factor')) ?>" aria-label="Back to entering the emailed code">Use the code from your email instead</a>.</p>
