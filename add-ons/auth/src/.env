# @addon-insert:append
# Encryption key, generated on composer install
APP_KEY=@app-key

# SMTP configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=username@example.com
SMTP_PASSWORD=password

# Development SMTP configuration (used while DEV=true)
SMTP_DEV_HOST=localhost
SMTP_DEV_PORT=25

# Mail configuration
MAIL_LOGO_URL=https://cdn.simpl.iwanvanderwal.nl/img/simpl-sm.png
# @addon-end
