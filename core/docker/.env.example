# Copy to the project root as `.env` to override the Docker Compose defaults below - entirely optional.

PHP_VERSION=8.5
MARIADB_VERSION=12.3
MAILPIT_VERSION=v1.31

# Linux only: set to your own `id -u`/`id -g` so files the container writes stay owned by you; rebuild after changing.
UID=1000
GID=1000

# APP_PORT defaults to 80 to match a typical APP_URL with no port suffix; override only if something else owns port 80.
APP_PORT=80

# APP_SSL_PORT is where the site is actually served (APP_PORT just redirects here); override only if something else owns port 443.
APP_SSL_PORT=443

# DB_PORT defaults away from a typical local MySQL/MariaDB install's usual 3306.
DB_PORT=3307

# Mailpit web UI, only meaningful once auth is installed.
MAILPIT_PORT=8025

# Overrides src/.env's DEV flag as a real container environment variable, without editing src/.env itself.
DEV=true

# Only meaningful once db is installed - must match src/.env's DB_PASSWORD, which is what the app connects with.
DB_PASSWORD=
