{
  "name": "simpl",
  "description": "An easy-to-use PHP, HTML, Sass and TypeScript framework!",
  "type": "module",
  "version": "2.0.0",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "hamburgers": "^1.2.1",
    "the-new-css-reset": "^1.11.3"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "npm-run-all": "^4.1.5",
    "sass": "^1.104.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "scripts": {
    "postinstall": "npm run build",
    "dev": "run-p watch live",
    "watch": "run-p watch:*",
    "watch:scss": "sass -w src/scss/main.scss:src/public/css/main.min.css -s compressed",
    "watch:ts": "vite build --watch",
    "live": "browser-sync start --proxy @app-url/ --host @app-host --https -f src/public/js/**/*.js src/public/css/**/*.css src/views/**/*.phtml --no-notify --no-ui --open external",
    "build": "run-s build:*",
    "build:scss": "sass src/scss/main.scss:src/public/css/main.min.css -s compressed",
    "build:ts": "vite build",
    "docker:sh": "docker compose exec app bash"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IJuanTM/simpl/"
  },
  "keywords": [
    "php",
    "html",
    "sass",
    "typescript",
    "framework",
    "mvc"
  ],
  "author": "Iwan van der Wal",
  "license": "GPL-3.0-only",
  "homepage": "https://simpl.iwanvanderwal.nl/"
}
