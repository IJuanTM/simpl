# Disable directory listings and MultiViews
Options -MultiViews -Indexes

# Deny access to sensitive files
<FilesMatch "\.(env|htaccess|ini|log|sql|git|bak|sh)$">
    Require all denied
</FilesMatch>

# Configure rewrite rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect to index.php if not a file or directory
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Add security headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Explicitly disabled: the XSS Auditor it toggled is gone from every current browser engine, and enabling it on the rare browser that still honors it has caused XSS bugs of its own.
    # CSP below is what actually mitigates XSS now.
    Header always set X-XSS-Protection "0"

    # Enforce HTTPS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Deny powerful browser features this app never uses
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # Isolate this site's browsing context from other origins
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # Block other origins from embedding this site's resources
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Content Security Policy. Assets are self-hosted; 'unsafe-inline' on script-src is required for the inline theme script.
    # style-src needs no 'unsafe-inline': no style="" attribute or <style> block exists anywhere, and the JS that touches .style sets properties directly, which CSP doesn't treat as inline.
    # Tightening script-src to a nonce/hash is a future improvement.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Leverage browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
