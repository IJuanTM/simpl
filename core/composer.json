{
  "name": "simpl/simpl",
  "description": "An easy-to-use PHP, HTML, Sass and TypeScript framework!",
  "version": "2.0.0",
  "type": "project",
  "require": {
    "php": "^8.5",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "ext-sodium": "*",
    "phpmailer/phpmailer": "^7.1.1",
    "vlucas/phpdotenv": "^v5.7.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^13.3.4",
    "phpstan/phpstan": "^2.2.14"
  },
  "autoload": {
    "psr-4": {
      "app\\": "src/app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\": "tests/app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "vendor-dir": "src/vendor"
  },
  "scripts": {
    "post-autoload-dump": "@php src/app/Scripts/app-key.php",
    "test": "phpunit --configuration=config/phpunit.xml --testsuite=Unit,Feature",
    "test:integration": "phpunit --configuration=config/phpunit.xml --testsuite=Integration",
    "stan": "phpstan analyse --configuration=config/phpstan.neon --memory-limit=512M",
    "key:regenerate": "@php src/app/Scripts/app-key.php --fresh",
    "docker": "docker compose exec app composer",
    "@addon-placeholder": "db"
  },
  "keywords": [
    "php",
    "html",
    "sass",
    "typescript",
    "framework",
    "mvc"
  ],
  "license": "GPL-3.0-only"
}
